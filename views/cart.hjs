<!DOCTYPE html>
<html>
  <head>
      <link rel='stylesheet' href='/styles/bootstrap.min.css' />
      <link rel='stylesheet' href='/styles/style.css' />
      <script src="/js/jquery-2.2.0.min.js" type="text/javascript"></script>
      <script src="/js/bootstrap.min.js" type="text/javascript"></script>
      <script src="/src/cart.js" type="text/javascript"></script>
  </head>
  <body>
    <div>
      <nav class="navbar navbar-inverse">
          <div class="container-fluid">
              <div class="navbar-header">
                  <a class="navbar-brand" href="/dashboard">GIU Food Trucks</a>
              </div>
              <ul class="nav navbar-nav">
                <li><a href="/dashboard">Dashboard</a></li>
                <li><a href="/trucks">Browse Trucks</a></li>
                <li class="active"><a href="/cart">Cart</a></li>
                <li><a href="/myOrders">My Orders</a></li>
              </ul>
              <ul class="nav navbar-nav navbar-right">
                <li><a href="#"><span class="glyphicon glyphicon-user"></span> {{ name }}</a></li>
                <li><a href="/logout"><span class="glyphicon glyphicon-log-out"></span> Logout</a></li>
              </ul>
          </div>
      </nav>
    </div>

    <div class="container" style="margin-top: 30px;">
      <div class="page-header">
        <h1><span class="glyphicon glyphicon-shopping-cart"></span> Shopping Cart</h1>
      </div>

      <div id="cart-items-container">
        <!-- Cart items will be loaded here by JavaScript -->
      </div>

      <div id="empty-cart-message" class="text-center" style="display: none; margin-top: 50px;">
        <span class="glyphicon glyphicon-shopping-cart" style="font-size: 80px; color: #ccc;"></span>
        <h3>Your cart is empty</h3>
        <p>Browse our food trucks to add items to your cart!</p>
        <a href="/trucks" class="btn btn-primary btn-lg">
