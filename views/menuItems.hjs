<!DOCTYPE html>
<html>
  <head>
      <link rel='stylesheet' href='/styles/bootstrap.min.css' />
      <link rel='stylesheet' href='/styles/style.css' />
      <script src="/js/jquery-2.2.0.min.js" type="text/javascript"></script>
      <script src="/js/bootstrap.min.js" type="text/javascript"></script>
      <script src="/src/menuItems.js" type="text/javascript"></script>
  </head>
  <body>
    <div>
      <nav class="navbar navbar-inverse">
          <div class="container-fluid">
              <div class="navbar-header">
                  <a class="navbar-brand" href="/ownerDashboard">GIU Food Trucks - Owner</a>
              </div>
              <ul class="nav navbar-nav">
                <li><a href="/ownerDashboard">Dashboard</a></li>
                <li class="active"><a href="/menuItems">Menu Items</a></li>
                <li><a href="/truckOrders">Orders</a></li>
              </ul>
              <ul class="nav navbar-nav navbar-right">
                <li><a href="#"><span class="glyphicon glyphicon-user"></span> {{ name }}</a></li>
                <li><a href="/logout"><span class="glyphicon glyphicon-log-out"></span> Logout</a></li>
              </ul>
          </div>
      </nav>
    </div>

    <div class="container" style="margin-top: 30px;">
      <div class="page-header">
        <h1><span class="glyphicon glyphicon-list"></span> Menu Items Management</h1>
        <a href="/addMenuItem" class="btn btn-success">
          <span class="glyphicon glyphicon-plus"></span> Add New Item
        </a>
      </div>

      <div id="menu-items-table-container">
        <!-- Menu items table will be loaded here by JavaScript -->
      </div>

      <div id="no-items-message" class="text-center" style="display: none; margin-top: 50px;">
        <span class="glyphicon glyphicon-cutlery" style="font-size: 80px; color: #ccc;"></span>
        <h3>No menu items yet</h3>
        <p>Start adding items to your menu!</p>
        <a href="/addMenuItem" class="btn btn-success btn-lg">
          <span class="glyphicon glyphicon-plus"></span> Add Menu Item
        </a>
      </div>

      <div id="loading-message" class="text-center" style="margin-top: 50px;">
        <span class="glyphicon glyphicon-refresh glyphicon-spin" style="font-size: 40px;"></span>
        <p>Loading menu items...</p>
      </div>
    </div>

    <!-- View Item Modal -->
    <div class="modal fade" id="viewItemModal" tabindex="-1" role="dialog">
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal">&times;</button>
            <h4 class="modal-title">Item Details</h4>
          </div>
          <div class="modal-body" id="item-details-content">
            <!-- Item details will be loaded here -->
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Edit Item Modal -->
    <div class="modal fade" id="editItemModal" tabindex="-1" role="dialog">
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal">&times;</button>
            <h4 class="modal-title">Edit Menu Item</h4>
          </div>
          <div class="modal-body">
            <form id="edit-item-form">
              <input type="hidden" id="edit-item-id">
              <div class="form-group">
                <label for="edit-name">Name *</label>
                <input type="text" class="form-control" id="edit-name" required>
              </div>
              <div class="form-group">
                <label for="edit-category">Category *</label>
                <select class="form-control" id="edit-category" required>
                  <option value="">Select Category</option>
                  <option value="appetizer">Appetizer</option>
                  <option value="main">Main Course</option>
                  <option value="dessert">Dessert</option>
                  <option value="beverage">Beverage</option>
                </select>
              </div>
              <div class="form-group">
                <label for="edit-description">Description</label>
                <textarea class="form-control" id="edit-description" rows="3"></textarea>
              </div>
              <div class="form-group">
                <label for="edit-price">Price ($) *</label>
                <input type="number" class="form-control" id="edit-price" step="0.01" min="0" required>
              </div>
            </form>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-primary" id="save-edit-btn">Save Changes</button>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>

