<!DOCTYPE html>
<html>
  <head>
      <link rel='stylesheet' href='/styles/bootstrap.min.css' />
      <link rel='stylesheet' href='/styles/style.css' />
      <script src="/js/jquery-2.2.0.min.js" type="text/javascript"></script>
      <script src="/js/bootstrap.min.js" type="text/javascript"></script>
      <script src="/src/addMenuItem.js" type="text/javascript"></script>
  </head>
  <body>
    <div>
      <nav class="navbar navbar-inverse">
          <div class="container-fluid">
              <div class="navbar-header">
                  <a class="navbar-brand" href="/ownerDashboard">GIU Food Trucks - Owner</a>
              </div>
              <ul class="nav navbar-nav">
                <li><a href="/ownerDashboard">Dashboard</a></li>
                <li class="active"><a href="/menuItems">Menu Items</a></li>
                <li><a href="/truckOrders">Orders</a></li>
              </ul>
              <ul class="nav navbar-nav navbar-right">
                <li><a href="#"><span class="glyphicon glyphicon-user"></span> {{ name }}</a></li>
                <li><a href="/logout"><span class="glyphicon glyphicon-log-out"></span> Logout</a></li>
              </ul>
          </div>
      </nav>
    </div>

    <div class="container" style="margin-top: 30px;">
      <div class="page-header">
        <h1><span class="glyphicon glyphicon-plus"></span> Add Menu Item</h1>
        <a href="/menuItems" class="btn btn-default">
          <span class="glyphicon glyphicon-arrow-left"></span> Back to Menu Items
        </a>
      </div>

      <div class="row">
        <div class="col-md-8 col-md-offset-2">
          <div class="panel panel-primary">
            <div class="panel-heading">
              <h3 class="panel-title">New Menu Item Details</h3>
            </div>
            <div class="panel-body">
              <form id="add-item-form">
                <div class="form-group">
                  <label for="name">Item Name *</label>
                  <input type="text" class="form-control" id="name" placeholder="e.g., Chicken Burger" required>
                </div>

                <div class="form-group">
                  <label for="category">Category *</label>
                  <select class="form-control" id="category" required>
                    <option value="">Select Category</option>
                    <option value="appetizer">Appetizer</option>
                    <option value="main">Main Course</option>
                    <option value="dessert">Dessert</option>
                    <option value="beverage">Beverage</option>
                  </select>
                </div>

                <div class="form-group">
                  <label for="description">Description</label>
                  <textarea class="form-control" id="description" rows="4" 
                            placeholder="Describe your item... (optional)"></textarea>
                  <small class="form-text text-muted">Add details about ingredients, preparation, or special features</small>
                </div>

                <div class="form-group">
                  <label for="price">Price ($) *</label>
                  <input type="number" class="form-control" id="price" step="0.01" min="0" 
                         placeholder="e.g., 9.99" required>
                </div>

                <div class="form-group text-right">
                  <a href="/menuItems" class="btn btn-default">
                    <span class="glyphicon glyphicon-remove"></span> Cancel
                  </a>
                  <button type="submit" class="btn btn-success" id="submit-btn">
                    <span class="glyphicon glyphicon-plus"></span> Add Menu Item
                  </button>
                </div>
              </form>
            </div>
          </div>

          <div class="panel panel-info">
            <div class="panel-heading">
              <h4 class="panel-title">Tips for Creating Menu Items</h4>
            </div>
            <div class="panel-body">
              <ul>
                <li><strong>Name:</strong> Use clear, descriptive names that customers will recognize</li>
                <li><strong>Category:</strong> Choose the appropriate category to help customers find items</li>
                <li><strong>Description:</strong> Highlight key ingredients and what makes the item special</li>
                <li><strong>Price:</strong> Set competitive prices that reflect the value of your items</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>

