<!DOCTYPE html>
<html>
  <head>
      <link rel='stylesheet' href='/styles/bootstrap.min.css' />
      <link rel='stylesheet' href='/styles/style.css' />
      <script src="/js/jquery-2.2.0.min.js" type="text/javascript"></script>
      <script src="/js/bootstrap.min.js" type="text/javascript"></script>
      <script src="/src/truckMenu.js" type="text/javascript"></script>
  </head>
  <body>
    <div>
      <nav class="navbar navbar-inverse">
          <div class="container-fluid">
              <div class="navbar-header">
                  <a class="navbar-brand" href="/dashboard">GIU Food Trucks</a>
              </div>
              <ul class="nav navbar-nav">
                <li><a href="/dashboard">Dashboard</a></li>
                <li><a href="/trucks">Browse Trucks</a></li>
                <li><a href="/cart">Cart</a></li>
                <li><a href="/myOrders">My Orders</a></li>
              </ul>
              <ul class="nav navbar-nav navbar-right">
                <li><a href="#"><span class="glyphicon glyphicon-user"></span> {{ name }}</a></li>
                <li><a href="/logout"><span class="glyphicon glyphicon-log-out"></span> Logout</a></li>
              </ul>
          </div>
      </nav>
    </div>

    <div class="container" style="margin-top: 30px;">
      <div class="page-header">
        <h1 id="truck-name">Menu</h1>
        <a href="/trucks" class="btn btn-default">
          <span class="glyphicon glyphicon-arrow-left"></span> Back to Trucks
        </a>
      </div>

      <div class="row" style="margin-bottom: 20px;">
        <div class="col-md-12">
          <div class="btn-group" role="group">
            <button type="button" class="btn btn-primary category-filter-btn active" data-category="all">All Items</button>
            <button type="button" class="btn btn-default category-filter-btn" data-category="appetizer">Appetizers</button>
            <button type="button" class="btn btn-default category-filter-btn" data-category="main">Main Course</button>
            <button type="button" class="btn btn-default category-filter-btn" data-category="dessert">Desserts</button>
            <button type="button" class="btn btn-default category-filter-btn" data-category="beverage">Beverages</button>
          </div>
        </div>
      </div>

      <div id="menu-items-container" class="row">
        <!-- Menu items will be loaded here by JavaScript -->
      </div>

      <div id="no-items-message" class="alert alert-info text-center" style="display: none;">
        <h3>No menu items available</h3>
        <p>This truck hasn't added any items yet.</p>
      </div>

      <div id="loading-message" class="text-center" style="margin-top: 50px;">
        <span class="glyphicon glyphicon-refresh glyphicon-spin" style="font-size: 40px;"></span>
        <p>Loading menu...</p>
      </div>
    </div>

    <!-- Hidden input to store truckId -->
    <input type="hidden" id="truck-id" value="{{ truckId }}">
  </body>
</html>

