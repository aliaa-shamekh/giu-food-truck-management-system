<!DOCTYPE html>
<html>
  <head>
      <link rel='stylesheet' href='/styles/bootstrap.min.css' />
      <link rel='stylesheet' href='/styles/style.css' />
      <script src="/js/jquery-2.2.0.min.js" type="text/javascript"></script>
      <script src="/js/bootstrap.min.js" type="text/javascript"></script>
      <script src="/src/truckOrders.js" type="text/javascript"></script>
      <style>
        .filter-tabs {
          margin-bottom: 20px;
        }
        .order-row {
          margin-bottom: 10px;
        }
        .status-pending { background-color: #fcf8e3; }
        .status-preparing { background-color: #d9edf7; }
        .status-ready { background-color: #dff0d8; }
        .status-completed { background-color: #e7e7e7; }
        .status-cancelled { background-color: #f2dede; }
      </style>
  </head>
  <body>
    <div>
      <nav class="navbar navbar-inverse">
          <div class="container-fluid">
              <div class="navbar-header">
                  <a class="navbar-brand" href="/ownerDashboard">GIU Food Trucks - Owner</a>
              </div>
              <ul class="nav navbar-nav">
                <li><a href="/ownerDashboard">Dashboard</a></li>
                <li><a href="/menuItems">Menu Items</a></li>
                <li class="active"><a href="/truckOrders">Orders</a></li>
              </ul>
              <ul class="nav navbar-nav navbar-right">
                <li><a href="#"><span class="glyphicon glyphicon-user"></span> {{ name }}</a></li>
                <li><a href="/logout"><span class="glyphicon glyphicon-log-out"></span> Logout</a></li>
              </ul>
          </div>
      </nav>
    </div>

    <div class="container" style="margin-top: 30px;">
      <div class="page-header">
        <h1><span class="glyphicon glyphicon-shopping-cart"></span> Truck Orders</h1>
      </div>

      <div class="filter-tabs">
        <div class="btn-group btn-group-justified" role="group">
          <div class="btn-group" role="group">
            <button type="button" class="btn btn-primary filter-btn active" data-filter="all">
              All Orders
            </button>
          </div>
          <div class="btn-group" role="group">
            <button type="button" class="btn btn-default filter-btn" data-filter="pending">
              Pending
            </button>
          </div>
          <div class="btn-group" role="group">
            <button type="button" class="btn btn-default filter-btn" data-filter="preparing">
              Preparing
            </button>
          </div>
          <div class="btn-group" role="group">
            <button type="button" class="btn btn-default filter-btn" data-filter="ready">
              Ready
            </button>
          </div>
          <div class="btn-group" role="group">
            <button type="button" class="btn btn-default filter-btn" data-filter="completed">
              Completed
            </button>
          </div>
          <div class="btn-group" role="group">
            <button type="button" class="btn btn-default filter-btn" data-filter="cancelled">
              Cancelled
            </button>
          </div>
        </div>
      </div>

      <div id="orders-container">
        <!-- Orders will be loaded here by JavaScript -->
      </div>

      <div id="no-orders-message" class="text-center" style="display: none; margin-top: 50px;">
        <span class="glyphicon glyphicon-list-alt" style="font-size: 80px; color: #ccc;"></span>
        <h3>No orders found</h3>
        <p>Orders will appear here when customers place them.</p>
      </div>

      <div id="loading-message" class="text-center" style="margin-top: 50px;">
        <span class="glyphicon glyphicon-refresh glyphicon-spin" style="font-size: 40px;"></span>
        <p>Loading orders...</p>
      </div>
    </div>

    <!-- Order Details Modal -->
    <div class="modal fade" id="orderDetailsModal" tabindex="-1" role="dialog">
      <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal">&times;</button>
            <h4 class="modal-title">Order Details</h4>
          </div>
          <div class="modal-body" id="order-details-content">
            <!-- Order details will be loaded here -->
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>

