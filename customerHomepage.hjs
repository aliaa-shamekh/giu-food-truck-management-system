<!DOCTYPE html>
<html>
  <head>
      <link rel='stylesheet' href='/styles/bootstrap.min.css' />
      <link rel='stylesheet' href='/styles/style.css' />
      <script src="/js/jquery-2.2.0.min.js" type="text/javascript"></script>
      <script src="/js/bootstrap.min.js" type="text/javascript"></script>
  </head>
  <body>
    <div>
      <nav class="navbar navbar-inverse">
          <div class="container-fluid">
              <div class="navbar-header">
                  <a class="navbar-brand" href="/dashboard">GIU Food Trucks</a>
              </div>
              <ul class="nav navbar-nav">
                <li class="active"><a href="/dashboard">Dashboard</a></li>
                <li><a href="/trucks">Browse Trucks</a></li>
                <li><a href="/cart">Cart</a></li>
                <li><a href="/myOrders">My Orders</a></li>
              </ul>
              <ul class="nav navbar-nav navbar-right">
                <li><a href="#"><span class="glyphicon glyphicon-user"></span> {{ name }}</a></li>
                <li><a href="/logout"><span class="glyphicon glyphicon-log-out"></span> Logout</a></li>
              </ul>
          </div>
      </nav>
    </div>

    <div class="container" style="margin-top: 30px;">
      <div class="jumbotron text-center">
        <h1>Welcome, {{ name }}!</h1>
        <p>Order delicious food from GIU food trucks</p>
      </div>

      <div class="row text-center">
        <div class="col-md-4">
          <div class="panel panel-primary">
            <div class="panel-heading">
              <h3 class="panel-title">Browse Trucks</h3>
            </div>
            <div class="panel-body">
              <span class="glyphicon glyphicon-road" style="font-size: 50px; color: #337ab7;"></span>
              <p style="margin-top: 20px;">Explore available food trucks</p>
              <a href="/trucks" class="btn btn-primary">View Trucks</a>
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="panel panel-success">
            <div class="panel-heading">
              <h3 class="panel-title">View Cart</h3>
            </div>
            <div class="panel-body">
              <span class="glyphicon glyphicon-shopping-cart" style="font-size: 50px; color: #5cb85c;"></span>
              <p style="margin-top: 20px;">Review and checkout your items</p>
              <a href="/cart" class="btn btn-success">Go to Cart</a>
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="panel panel-info">
            <div class="panel-heading">
              <h3 class="panel-title">My Orders</h3>
            </div>
            <div class="panel-body">
              <span class="glyphicon glyphicon-list-alt" style="font-size: 50px; color: #5bc0de;"></span>
              <p style="margin-top: 20px;">Track your order history</p>
              <a href="/myOrders" class="btn btn-info">View Orders</a>
            </div>
          </div>
        </div>
      </div>

      <div class="row" style="margin-top: 30px;">
        <div class="col-md-12">
          <div class="panel panel-default">
            <div class="panel-heading">
              <h3 class="panel-title">How It Works</h3>
            </div>
            <div class="panel-body">
              <div class="row">
                <div class="col-md-3 text-center">
                  <span class="glyphicon glyphicon-search" style="font-size: 40px; color: #337ab7;"></span>
                  <h4>1. Browse</h4>
                  <p>Explore available food trucks and their menus</p>
                </div>
                <div class="col-md-3 text-center">
                  <span class="glyphicon glyphicon-plus" style="font-size: 40px; color: #5cb85c;"></span>
                  <h4>2. Add to Cart</h4>
                  <p>Select your favorite items and add them to cart</p>
                </div>
                <div class="col-md-3 text-center">
                  <span class="glyphicon glyphicon-time" style="font-size: 40px; color: #f0ad4e;"></span>
                  <h4>3. Schedule</h4>
                  <p>Choose your preferred pickup time</p>
                </div>
                <div class="col-md-3 text-center">
                  <span class="glyphicon glyphicon-ok" style="font-size: 40px; color: #d9534f;"></span>
                  <h4>4. Pickup</h4>
                  <p>Collect your order when ready</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
